# Copy this file to .env and paste your keys in.  .env is gitignored; this file is not.
#
# Nothing here is REQUIRED. With every value blank, PatchPilot still runs the whole graph offline
# in recorded mode with deterministic fallbacks — that is the default, and what CI uses.
# Each key below buys one specific capability.


# ---------------------------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------------------------
# "recorded" replays the JSON fixtures under src/patchpilot/recorded/fixtures (zero network).
# "live" calls OSV.dev / FIRST EPSS / PyPI / GitHub, and runs the sandbox in Docker for real.
# PATCHPILOT_RECORD=1 in live mode writes every response back as a fixture.
PATCHPILOT_MODE=recorded
PATCHPILOT_RECORD=0


# ---------------------------------------------------------------------------------------------
# 1. OPENAI_API_KEY  — the two bounded LLM tasks and the changelog embeddings
# ---------------------------------------------------------------------------------------------
# Buys:  model-written justifications (llm/justify.py) and breaking-change summaries
#        (llm/changelog.py), both citation-checked, plus embedding-based changelog retrieval
#        instead of the lexical fallback. Required in step 8 for the faithfulness judge.
# Costs: well under a cent per scan of the fixture app on gpt-4o-mini.
# Needs: pip install -e ".[llm]"   (the base install does NOT pull langchain-openai)
# Without it: deterministic templates. Decisions are IDENTICAL either way, by design (ADR-0002).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

PATCHPILOT_MODEL_PRIMARY=gpt-4o-mini
PATCHPILOT_MODEL_JUDGE=gpt-4o
PATCHPILOT_MODEL_EMBEDDINGS=text-embedding-3-small

# Force the deterministic path even when a key is set (a free, reproducible demo run):
# PATCHPILOT_LLM=off


# ---------------------------------------------------------------------------------------------
# 2. GITHUB_TOKEN  — changelog rate limits now, opening PRs from step 7
# ---------------------------------------------------------------------------------------------
# Buys now:   changelog_rag reads api.github.com for release notes. Unauthenticated that is 60
#             requests/hour; any token raises it to 5000. For this, a classic token with NO scopes
#             ticked is enough — release notes are public data.
# Buys later: step 7's execute_pr. That one must be a FINE-GRAINED token, scoped to the
#             patchpilot-demo-app repository ONLY, with exactly:
#                 Repository permissions -> Contents:      Read and write
#                 Repository permissions -> Pull requests: Read and write
#             Nothing else. No org access and no workflow scope — writes to .github/** are refused
#             by guardrails/allowlist.py regardless, and merge and force-push are not implemented
#             as tools at all.
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=


# ---------------------------------------------------------------------------------------------
# 3. LANGSMITH  — tracing, and the golden dataset in step 8
# ---------------------------------------------------------------------------------------------
# Buys: a trace of every graph node and model call with no code changes, and the trace URL that
#       goes into each PR body and ledger row. The free Developer plan is enough.
# Tracing only emits when LANGSMITH_TRACING is exactly "true".
# Get a key at: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=patchpilot


# ---------------------------------------------------------------------------------------------
# 4. Durable state — checkpoints and the decision ledger
# ---------------------------------------------------------------------------------------------
# Leave DATABASE_URL COMMENTED OUT and both live in the local SQLite file below, which is what
# makes `patchpilot scan` then `patchpilot queue approve` work in two separate processes with
# nothing installed and no database running.
#
# Uncomment it only after `docker compose up -d postgres`, and install the extra with
# pip install -e ".[postgres]" — otherwise every command fails trying to reach a database that
# is not there.
# DATABASE_URL=postgresql://patchpilot:patchpilot@localhost:5432/patchpilot
PATCHPILOT_CHECKPOINT_DB=.patchpilot/checkpoints.sqlite


# ---------------------------------------------------------------------------------------------
# No key is needed for OSV.dev, FIRST EPSS or PyPI — all public and unauthenticated.
# ---------------------------------------------------------------------------------------------

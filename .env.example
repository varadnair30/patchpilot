# Mode: "recorded" replays JSON fixtures under src/patchpilot/recorded/fixtures (default, zero network).
#       "live" calls OSV.dev / FIRST EPSS / GitHub. Set PATCHPILOT_RECORD=1 in live mode to write fixtures.
PATCHPILOT_MODE=recorded
PATCHPILOT_RECORD=0

# LLM (used from step 3 onward; never needed by the approval queue service)
OPENAI_API_KEY=
PATCHPILOT_MODEL_PRIMARY=gpt-4o-mini
PATCHPILOT_MODEL_JUDGE=gpt-4o

# LangSmith (Developer plan is enough)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=patchpilot

# Durable checkpoints + decision ledger (step 5 onward).
# Unset DATABASE_URL and PatchPilot uses the local SQLite file below instead, so
# `patchpilot scan` then `patchpilot queue approve` works with no database running.
DATABASE_URL=postgresql://patchpilot:patchpilot@localhost:5432/patchpilot
PATCHPILOT_CHECKPOINT_DB=.patchpilot/checkpoints.sqlite

# GitHub fine-grained token scoped to patchpilot-demo-app only (step 6 onward)
GITHUB_TOKEN=
